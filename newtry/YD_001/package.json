{
  "name": "yd001-by-source",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "node extract_yd001_from_sefaria_bundle.mjs --siman 1 --from 1 --to 14 --out-subdir siman_001",
    "apply:dictionary": "node apply_dictionary_yd001.mjs",
    "apply:dictionary:dry": "node apply_dictionary_yd001.mjs --dry-run",
    "bootstrap:yd-simanim": "node tools/bootstrap-yd-simanim-from-bundles.mjs --from 1 --to 403 --skip-existing",
    "scaffold": "node tools/scaffold-from-oc001.mjs",
    "queue:generate": "node tools/generate-translation-queue.mjs",
    "pipeline:refresh": "node sa-checklist.mjs --out output --section YD",
    "pipeline:structure-check": "node tools/structure-parity-check.mjs",
    "pipeline:structure-check:ci": "node tools/structure-parity-check.mjs --ci",
    "pipeline:queue": "node pipeline/queue-next.mjs --out output",
    "pipeline:batch": "node pipeline/build-agent-batch.mjs",
    "pipeline:validate": "node pipeline/validate-yd001.mjs --root output",
    "pipeline:validate:quality": "node pipeline/validate-quality-yd001.mjs --root output --write-reports",
    "pipeline:validate:all": "npm run pipeline:validate && npm run pipeline:validate:quality",
    "pipeline:quality:batch": "node pipeline/build-quality-batch.mjs",
    "pipeline:editorial:loop": "node pipeline/editorial-loop.mjs",
    "pipeline:editorial:advance": "node pipeline/editorial-advance.mjs",
    "pipeline:editorial:batch": "node pipeline/build-editorial-siman-batch.mjs",
    "pipeline:cloud:prep": "node pipeline/prepare-cloud-batches.mjs",
    "pipeline:cloud:launch": "node pipeline/launch-cloud-agents.mjs",
    "pipeline:orchestrator": "node pipeline/orchestrator.mjs",
    "pipeline:orchestrator:sync": "node pipeline/orchestrator.mjs sync",
    "pipeline:orchestrator:status": "node pipeline/orchestrator.mjs status",
    "pipeline:pool:status": "node pipeline/pool-coordinator.mjs status",
    "pipeline:pool:tick": "node pipeline/pool-coordinator.mjs tick --workers 4",
    "pipeline:pool:watch": "node pipeline/pool-coordinator-watch.mjs --workers 4 --interval 90",
    "pipeline:pool:watch:assign": "node pipeline/pool-coordinator-watch.mjs --workers 4 --interval 90 --assign-only",
    "pipeline:pool:autopilot": "node pipeline/pool-autopilot.mjs --workers 4 --interval 60",
    "pipeline:pool:release-stale": "node pipeline/pool-coordinator.mjs release-stale",
    "pipeline:phase:status": "node pipeline/pool-phase.mjs status",
    "pipeline:sprint:finish": "node pipeline/sprint-worker.mjs",
    "pipeline:sprint": "node pipeline/sprint.mjs --out output",
    "libre:up": "node tools/run-docker-compose.mjs -f docker/libretranslate/docker-compose.yml up -d",
    "libre:down": "node tools/run-docker-compose.mjs -f docker/libretranslate/docker-compose.yml down",
    "libre:test": "node tools/test-libretranslate.mjs",
    "translate:placeholders:libre": "node tools/translate-yd001-pending-mymemory.mjs --backend libre --root output --ms 0 --workers 6 --chunk-len 500",
    "translate:placeholders:libre:safe": "node tools/translate-yd001-pending-mymemory.mjs --backend libre --root output --ms 100 --workers 3 --chunk-len 400",
    "translate:placeholders:auto": "node tools/translate-yd001-pending-mymemory.mjs --backend auto --root output --ms 3000 --workers 1",
    "publish:prepare:siman1": "node \"../../Sefaria Pulls/shulchan-arukh/Yoreh_Deah/tools/build-manifest-template-from-yd001.mjs\" --siman 1 --write-seif 1 && node \"../../Sefaria Pulls/shulchan-arukh/Yoreh_Deah/tools/prepare-translated-siman-slice.mjs\" --siman 1 --from 1 --to 14",
    "publish:siman": "node \"../../Sefaria Pulls/shulchan-arukh/Yoreh_Deah/tools/publish-yd-siman.mjs\"",
    "quality:viewer": "npm run dev --prefix tools/quality-viewer",
    "quality:llm:pending": "npm run llm:pending --prefix tools/quality-viewer",
    "quality:llm:quality-pass": "npm run llm:quality-pass --prefix tools/quality-viewer",
    "quality:llm:all": "npm run llm:all --prefix tools/quality-viewer",
    "quality:ipex:setup": "npm run ipex:setup --prefix tools/quality-viewer",
    "quality:ipex:model:fast": "npm run ipex:model:fast --prefix tools/quality-viewer",
    "quality:ipex:server": "npm run ipex:server:ps1 --prefix tools/quality-viewer",
    "quality:worker:init": "node pipeline/quality-worker.mjs init",
    "quality:worker:next": "node pipeline/quality-worker.mjs next",
    "quality:worker:commit": "node pipeline/quality-worker.mjs commit",
    "quality:worker:skip": "node pipeline/quality-worker.mjs skip",
    "quality:worker:status": "node pipeline/quality-worker.mjs status",
    "quality:worker:loop": "node pipeline/quality-worker.mjs next",
    "quality:mechaber:cleanup": "node pipeline/work/_mechaber-cleanup-failing.mjs",
    "quality:slot3:mt": "node pipeline/work/_slot3-mt-cleanup.mjs",
    "quality:slot3:scan": "node pipeline/work/_slot3-scan-range.mjs 201 300",
    "quality:corpus:fix-entities": "node pipeline/work/_corpus-fix-entities.mjs",
    "quality:corpus:fix-newlines": "node pipeline/work/_corpus-fix-english-newlines.mjs",
    "quality:corpus:recover-embedded": "node pipeline/work/_corpus-recover-embedded-english.mjs",
    "quality:corpus:retranslate": "node pipeline/work/_corpus-retranslate-errors.mjs",
    "quality:corpus:mt-scan": "node pipeline/work/_corpus-mt-scan.mjs",
    "quality:libre:wave": "node pipeline/work/_editorial-libre-wave.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.18"
  }
}
