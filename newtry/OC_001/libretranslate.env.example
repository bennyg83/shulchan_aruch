# Copy to libretranslate.env (optional) or set in your shell before translate runs.
LIBRE_URL=http://localhost:5000
# Self-hosted LibreTranslate usually needs no key. Public libretranslate.com may require one.
# LIBRE_API_KEY=

# MT fallback order when using --backend auto (libre last = local Docker)
OC001_MT_CHAIN=google,mymemory,lingva,libre
